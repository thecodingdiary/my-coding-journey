#include <stdio.h>
int main()
{
    int a[8]={10, 7, 24, 9, 15, 6, 31, 40};
    int i;
    int even=0;
    int odd=0;
    for(i=0;i<8;i++)
        {
            if(a[i]%2==0)
            {
                even++;
            }
            else
            {
                odd++;
            }
        }
    printf("Even numbers:%d\n",even);
    printf("Odd numbers:%d\n",odd);
    return 0;
}
