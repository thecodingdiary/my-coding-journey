#include <stdio.h>
int main()
{
    int year;
    printf("Enter a year:");
    scanf("%d",&year);
    if(year%400==0)
    {
        printf("The given year is a leap year");
    }
    if(year%4==0)
    {
        if(year%100!=0)
        {
            printf("The given year is a leap year");
        }
        else
        {
            printf("The given year is not a leap year");
        }
    }
    else
    {
        printf("The given year is not a leap year");
    }
    return 0;
}
