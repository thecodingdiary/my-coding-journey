#include <stdio.h>
int main()
{
    int num;
    printf("Enter a number:");
    scanf("%d",&num);
    if(num>=0)
    {
        if(num==0)
        {
            printf("YOUR NUMBER IS ZERO");
        }
        else
        {
            printf("YOUR ENTERED NUMBER IS POSITIVE");
        }
    }
    else
    {
        printf("YOUR ENTERED NUMBER IS NEGATIVE");
    }
    return 0;
}
    
